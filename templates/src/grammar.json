      "value": "<%--(?:[^-]|-[-]*(?:[^%-]|%[^%->]|%%)|(?:-|-[-]*%-)(?:-[-]*%-)*(?:[^%-]|%|-[-]*(?:[^%-]|%[^%->]|%%)))(?:-|-[-]*%-)?--%>"
