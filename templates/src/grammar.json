{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gosu_templates",
  "rules": {
    "template": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "template_comment"
          },
          {
            "type": "SYMBOL",
            "name": "template_directive"
          },
          {
            "type": "SYMBOL",
            "name": "template_expression"
          },
          {
            "type": "SYMBOL",
            "name": "template_scriptlet"
          },
          {
            "type": "SYMBOL",
            "name": "template_interpolation"
          },
          {
            "type": "SYMBOL",
            "name": "template_text"
          }
        ]
      }
    },
    "template_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<%--"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^-]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "-[^-]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "--[^%]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "--%[^>]"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "--%>"
            }
          ]
        }
      }
    },
    "template_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<%@"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_scriptlet_item"
          }
        },
        {
          "type": "STRING",
          "value": "%>"
        }
      ]
    },
    "template_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<%="
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_scriptlet_item"
          }
        },
        {
          "type": "STRING",
          "value": "%>"
        }
      ]
    },
    "template_scriptlet": {
      "type": "SEQ",
      "members": [
        {
          "type": "PREC",
          "value": 1,
          "content": {
            "type": "STRING",
            "value": "<%"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_scriptlet_item"
          }
        },
        {
          "type": "STRING",
          "value": "%>"
        }
      ]
    },
    "_scriptlet_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "block_comment"
        },
        {
          "type": "SYMBOL",
          "name": "line_comment"
        },
        {
          "type": "SYMBOL",
          "name": "StringLiteral"
        },
        {
          "type": "SYMBOL",
          "name": "code_fragment"
        }
      ]
    },
    "template_interpolation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "${"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "block_comment"
              },
              {
                "type": "SYMBOL",
                "name": "StringLiteral"
              },
              {
                "type": "SYMBOL",
                "name": "interpolation_code"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "block_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\/\\*([^*]|\\*+[^*/])*\\*+\\/"
      }
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\/\\/([^\\n\\r%]|%[^>])*"
      }
    },
    "StringLiteral": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^\"\\\\]+"
                    },
                    {
                      "type": "PATTERN",
                      "value": "\\\\."
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "\""
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "'"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^'\\\\]+"
                    },
                    {
                      "type": "PATTERN",
                      "value": "\\\\."
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "'"
              }
            ]
          }
        ]
      }
    },
    "code_fragment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^%/\"'\\s]"
                },
                {
                  "type": "PATTERN",
                  "value": "%[^>]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\/[^*/]"
                }
              ]
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^%/\"']+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "%[^>]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\/[^*/]"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "interpolation_code": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^}/\"'\\s]+"
              },
              {
                "type": "PATTERN",
                "value": "\\/[^*/]"
              }
            ]
          }
        }
      }
    },
    "template_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^<$\\s]"
                },
                {
                  "type": "PATTERN",
                  "value": "<[^%]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\$[^{]"
                }
              ]
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^<$]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "<[^%]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\$[^{]"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}