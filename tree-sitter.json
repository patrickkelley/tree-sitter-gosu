{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gosu",
      "path": ".",
      "camelcase": "Gosu",
      "title": "Gosu",
      "scope": "source.gosu",
      "file-types": [
        "gs",
        "gsp",
        "gsx"
      ],
      "injection-regex": "^gosu$",
      "class-name": "TreeSitterGosu"
    },
    {
      "name": "gosu_templates",
      "path": "templates",
      "camelcase": "GosuTemplates",
      "title": "Gosu Templates",
      "scope": "source.gosu.template",
      "file-types": [
        "gst"
      ],
      "injection-regex": "^gosu_templates$",
      "class-name": "TreeSitterGosuTemplates"
    }
  ],
  "metadata": {
    "version": "0.1.3",
    "license": "MIT",
    "description": "Gosu is a statically typed general-purpose programming language that runs on the Java Virtual Machine.",
    "authors": [
      {
        "name": "Marek Kubica",
        "email": "marek@tarides.com",
        "url": "https://tarides.com/"
      }
    ],
    "links": {
      "repository": "https://github.com/patrickkelley/tree-sitter-gosu"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}